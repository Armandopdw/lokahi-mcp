{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lokahi-mcp",
  "main": "src/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "e44c27188b4e45f4843e64366eb085f5" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "LokahiMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["LokahiMCP"] }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
